# Base URL of the backend API
REACT_APP_API_BASE_URL=http://localhost:5001

# Storage account that holds the audio files
REACT_APP_STORAGE_ACCOUNT_NAME=your_storage_account_name

# Base URL of the audio storage. Optional.
# If you leave it unset, the app uses https://<REACT_APP_STORAGE_ACCOUNT_NAME>.blob.core.windows.net
REACT_APP_AUDIO_STORAGE_BASE_URL=
