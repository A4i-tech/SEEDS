server {
    listen 8080;
    server_name _;

    # An unset or empty variable makes these lines invalid, so nginx exits at start.
    set $api_base_url ${REACT_APP_API_BASE_URL};
    set $api_proxy_target "${REACT_APP_API_PROXY_TARGET}";
    set $storage_account_name ${REACT_APP_STORAGE_ACCOUNT_NAME};

    location /api/ {
        resolver ${NGINX_LOCAL_RESOLVERS} valid=30s;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api_proxy_target;
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /env.js {
        default_type application/javascript;
        add_header Cache-Control "no-store";
        return 200 "window.__ENV__={REACT_APP_API_BASE_URL:'$api_base_url',REACT_APP_STORAGE_ACCOUNT_NAME:'$storage_account_name'};";
    }

    # Serve static files from the build directory
    location / {
        root /usr/share/nginx/html;
        
        # Try to serve the requested file
        # If not found, serve index.html (for SPA routing)
        try_files $uri $uri/ /index.html;
    }

    location = /index.html {
        root /usr/share/nginx/html;
        add_header Cache-Control "no-cache";
    }

    # Cache busting for versioned assets
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        root /usr/share/nginx/html;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
