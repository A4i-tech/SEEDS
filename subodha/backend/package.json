{
  "name": "subodha-importer",
  "version": "1.0.0",
  "description": "Batch job: pull all Subodha (Open edX) courses to local disk",
  "main": "dist/src/index.js",
  "scripts": {
    "start": "tsx src/index.ts",
    "dry-run": "cross-env SUBODHA_DRY_RUN=true tsx src/index.ts",
    "test-run": "cross-env SUBODHA_LIMIT=10 tsx src/index.ts",
    "server": "tsx src/server.ts",
    "webhook-listener": "tsx webhook-listener.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.33.0",
    "axios": "^1.7.0",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "mongodb": "^7.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
