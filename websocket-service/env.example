# Storage provider for audio files. Use object-store or azure.
STORAGE_BACKEND=object-store

# Object store settings. The bucket name comes from each audio URL, so no bucket setting exists.
OBJECT_STORE_ENDPOINT_URL=http://localhost:9000
OBJECT_STORE_ACCESS_KEY_ID=
OBJECT_STORE_SECRET_ACCESS_KEY=
OBJECT_STORE_REGION=us-east-1

# Azure settings. These apply only when STORAGE_BACKEND=azure.
# Leave AZURE_STORAGE_ACCOUNT_KEY empty to sign in with DefaultAzureCredential.
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
