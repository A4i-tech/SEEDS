# Storage provider for audio files. Use s3 (default) or azure.
STORAGE_BACKEND=s3

# S3 settings. The bucket name comes from each audio URL, so no bucket setting exists.
# Leave S3_ENDPOINT_URL empty to use AWS.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1

# Azure settings. These apply only when STORAGE_BACKEND=azure.
# Leave AZURE_STORAGE_ACCOUNT_KEY empty to sign in with DefaultAzureCredential.
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
